# Copy to .env and fill in. Never commit the real .env.

# --- Required -----------------------------------------------------------------

# Long random secret for session tokens (and the key that encrypts the SMTP password):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection used by the app (Supabase session pooler, role hse_app).
# Local development and tests can use an in-process database instead: pglite:///absolute/path/to/folder
DATABASE_URL=postgresql://hse_app.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- Server -------------------------------------------------------------------

PORT=3000
# Public address of the site, used in QR codes, emails and canonical links.
PUBLIC_BASE_URL=
TZ=Africa/Cairo
JWT_EXPIRES_IN=30m
WORKER_JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# --- Database (optional) ------------------------------------------------------

# Role allowed to run DDL, only needed for `npm run db:migrate`.
DATABASE_ADMIN_URL=
# PEM file of the database CA to verify the TLS certificate (otherwise encrypted but unverified).
DATABASE_SSL_CA=
# Local folders for snapshots, generated files and uploaded lecture recordings.
HSE_DATA_DIR=
HSE_UPLOADS_DIR=

# --- Web push (optional) ------------------------------------------------------
# Generated once and stored in the database when left empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (optional) ---------------------------------------------------------
# Normally configured from the admin screen (stored encrypted in the database);
# these values are only a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- WhatsApp Cloud API (optional) --------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# --- Chatbot language model (optional) ----------------------------------------
# Without a key the assistant answers from the built-in knowledge base only.
# Only the question, the matching safety-instruction excerpts and the user's
# role/department are sent — never employee or report data.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CHATBOT_LLM_PROVIDER=
CHATBOT_LLM_MODEL=
CHATBOT_LLM_EFFORT=low
CHATBOT_LLM_TIMEOUT_MS=20000
CHATBOT_LLM_POLISH=

# --- Local HTTPS for the factory network (optional) ----------------------------
# Browsers only allow the microphone and notifications over https.
ENABLE_HTTPS=false
HTTPS_PORT=3443
