{
  "name": "hse-platform",
  "version": "3.0.0",
  "private": true,
  "description": "Health & Safety platform for Elsewedy Polymers: work permits, hazard reporting, training, drills, inspections and penalties.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build-assets.js",
    "build:check": "node scripts/build-assets.js --check",
    "db:migrate": "node scripts/db-migrate.js",
    "db:restore": "node scripts/restore-backup.js",
    "db:import-teams": "node scripts/import-emergency-teams.js",
    "lint": "eslint .",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "docx": "^9.5.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.39.5",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "terser": "^5.51.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
